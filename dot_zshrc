# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

source /home/sigrika/.cachyos-zsh-config.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
# [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
fastfetch

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Wayland environment configuration for Fcitx5
export XMODIFIERS=@im=fcitx
export QT_IM_MODULE=fcitx
# GTK_IM_MODULE is handled via settings.ini instead of environment variables to avoid breaking Wayland GTK apps.
# export GTK_IM_MODULE=fcitx

# NVIDIA VA-API hardware acceleration
export LIBVA_DRIVER_NAME=nvidia



# Added by Antigravity CLI installer
export PATH="/home/sigrika/.local/bin:$PATH"

# Initialize Starship Prompt
eval "$(starship init zsh)"

# mimocode
export PATH=/home/sigrika/.mimocode/bin:$PATH

# bun completions
[ -s "/home/sigrika/.bun/_bun" ] && source "/home/sigrika/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# opencode
export PATH=/home/sigrika/.opencode/bin:$PATH

# dotenv loader
if [[ -f "$HOME/.env" ]]; then
  while IFS= read -r line; do
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" == *"="* ]]; then
      export "$line"
    fi
  done < "$HOME/.env"
fi

# kimi-code
export PATH="/home/sigrika/.kimi-code/bin:$PATH"
# lean-ctx shell hook — begin
if [ -f "/home/sigrika/.config/lean-ctx/shell-hook.zsh" ]; then
. "/home/sigrika/.config/lean-ctx/shell-hook.zsh"
fi
# lean-ctx shell hook — end

# >>> lean-ctx agent aliases >>>
alias claude='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" claude'
alias codebuddy='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" codebuddy'
alias codex='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" codex'
alias gemini='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" gemini'
# <<< lean-ctx agent aliases <<<

# Smart proxy configuration for local proxy (FlClash)
proxy_on() {
    export http_proxy="http://127.0.0.1:7897"
    export https_proxy="http://127.0.0.1:7897"
    export all_proxy="socks5://127.0.0.1:7897"
    export NO_PROXY="localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16"
    export no_proxy="$NO_PROXY"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$https_proxy"
    export ALL_PROXY="$all_proxy"
    echo "Proxy enabled (127.0.0.1:7897)"
}

proxy_off() {
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY no_proxy NO_PROXY
    echo "Proxy disabled"
}

# Auto-enable proxy only if port 7897 is actively listening (safe fallback)
if timeout 0.1 bash -c 'true >/dev/tcp/127.0.0.1/7897' 2>/dev/null; then
    proxy_on >/dev/null 2>&1
fi
